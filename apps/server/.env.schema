# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Google OAuth client (ADR 0004). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# The client id is public by design: it is sent to the browser in the Google
# authorization URL, so it must not be marked sensitive (Varlock would block
# that response as a leak). The secret stays sensitive.
# @public @type=string(minLength=1)
GOOGLE_CLIENT_ID=

# @type=string(minLength=1)
GOOGLE_CLIENT_SECRET=

# --- Telegram bot (ADR 0002). Leave TELEGRAM_BOT_TOKEN empty to run without the bot.
# @optional
TELEGRAM_BOT_TOKEN=

# polling: local development, no public URL needed. webhook: production.
# @public @type=enum(polling, webhook)
TELEGRAM_MODE=polling

# Sent by Telegram in X-Telegram-Bot-Api-Secret-Token; 1-256 chars of A-Z a-z 0-9 _ -
# @required=eq($TELEGRAM_MODE, webhook) @type=string(minLength=16, maxLength=256)
TELEGRAM_WEBHOOK_SECRET=

# --- LLM parsing via OpenRouter (ADR 0006). Required when the bot is enabled.
# @optional
OPENROUTER_API_KEY=

# @public @type=string(minLength=1)
LLM_MODEL=anthropic/claude-haiku-5.5
