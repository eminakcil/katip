{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/.next",
			"!**/dist",
			"!**/.turbo",
			"!**/.nx",
			"!**/dev-dist",
			"!**/.zed",
			"!**/.vscode",
			"!**/routeTree.gen.ts",
			"!**/src-tauri",
			"!**/.nuxt",
			"!bts.jsonc",
			"!**/.expo",
			"!**/.wrangler",
			"!**/.alchemy",
			"!**/.svelte-kit",
			"!**/wrangler.jsonc",
			"!**/.source",
			"!**/convex/_generated",
			"!**/src/env.ts",
			"!**/src/migrations"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useExhaustiveDependencies": "info"
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			},
			"style": {
				"noParameterAssign": "error",
				"useAsConstAssertion": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"noUnusedTemplateLiteral": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/ui/src/components/**"],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": "off",
						"useSemanticElements": "off",
						"useKeyWithClickEvents": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/core/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@katip/*",
											"grammy",
											"grammy/**",
											"@grammyjs/**",
											"hono",
											"hono/**",
											"@hono/**",
											"@trpc/**",
											"drizzle-orm",
											"drizzle-orm/**",
											"drizzle-kit",
											"pg",
											"pg/**",
											"pg-boss",
											"@electric-sql/**",
											"better-auth",
											"better-auth/**",
											"@better-auth/**",
											"varlock",
											"varlock/**",
											"openai",
											"@anthropic-ai/**",
											"@openrouter/**",
											"axios",
											"undici",
											"node:http",
											"node:https",
											"node:net",
											"**/telegram/**",
											"**/db/**",
											"**/api/**",
											"**/auth/**",
											"**/server/**",
											"**/scheduler/**",
											"**/web/**"
										],
										"message": "packages/core must not import adapters, other workspace packages or infrastructure libraries (ADR 0002). Add a port instead."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
